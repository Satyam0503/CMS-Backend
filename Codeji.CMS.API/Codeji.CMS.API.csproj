<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- The .NET 10 SDK trips on the implicit <EmbeddedResource Include="**/*.resx" />
         when zero files match. Explicit Remove keeps the rest of the implicit globs
         (Compile, Content) functional. -->
    <EmbeddedResource Remove="**/*.resx" />
    <!-- Templates ship next to the binary so HtmlTemplate.Render can read them at runtime. -->
    <Content Include="Templates\**\*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="HtmlSanitizer" Version="9.0.892" />
    <!-- Microsoft.AspNetCore.SignalR is bundled in the .NET 10 framework
         (Microsoft.NET.Sdk.Web); the explicit NuGet ref is redundant and trips
         dotnet watch's NU1510 prune check during hot reload. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Codeji.CMS.Repository\Codeji.CMS.Repository.csproj" />
    <ProjectReference Include="..\Codeji.CMS.Services\Codeji.CMS.Services.csproj" />
    <ProjectReference Include="..\Codeji.CMS.DTO\Codeji.CMS.DTO.csproj" />
    <ProjectReference Include="..\Codeji.CMS.Utility\Codeji.CMS.Utility.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ensure runtime upload directories exist post-publish. -->
    <Folder Include="Properties\" />
  </ItemGroup>
</Project>